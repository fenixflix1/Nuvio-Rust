{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuvio",
  "version": "0.0.6",
  "identifier": "tv.nuvio.desktop.rust",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nuvio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
